<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Record Rules — brightloop_finance
            Member 4: Customer Data Isolation

            Enforcement policy:
            - Finance Manager : unrestricted access to all records (no rule applied)
            - Finance User    : unrestricted access to all records (internal staff)
            - Portal/Customer : can only read their own payments and allocations

            Rules use domain filters so Odoo enforces them at the ORM level —
            not just at the view level. They cannot be bypassed by direct
            RPC calls or controller endpoints.
        -->

        <!-- ─── brightloop.payment — Customer read rule ───────────────────── -->
        <record id="rule_payment_portal_read" model="ir.rule">
            <field name="name">Payment: portal users see only their own</field>
            <field name="model_id" ref="model_brightloop_payment"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Finance users: full unrestricted read/write (no domain restriction) -->
        <record id="rule_payment_finance_user_all" model="ir.rule">
            <field name="name">Payment: finance users see all</field>
            <field name="model_id" ref="model_brightloop_payment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('brightloop_finance.group_brightloop_finance_user'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Finance managers: full unrestricted access including delete -->
        <record id="rule_payment_finance_manager_all" model="ir.rule">
            <field name="name">Payment: finance managers see all</field>
            <field name="model_id" ref="model_brightloop_payment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('brightloop_finance.group_brightloop_finance_manager'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ─── brightloop.invoice.payment — Customer read rule ──────────── -->
        <record id="rule_invoice_payment_portal_read" model="ir.rule">
            <field name="name">Invoice Payment: portal users see only their own</field>
            <field name="model_id" ref="model_brightloop_invoice_payment"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_invoice_payment_finance_user_all" model="ir.rule">
            <field name="name">Invoice Payment: finance users see all</field>
            <field name="model_id" ref="model_brightloop_invoice_payment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('brightloop_finance.group_brightloop_finance_user'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_invoice_payment_finance_manager_all" model="ir.rule">
            <field name="name">Invoice Payment: finance managers see all</field>
            <field name="model_id" ref="model_brightloop_invoice_payment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('brightloop_finance.group_brightloop_finance_manager'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>

