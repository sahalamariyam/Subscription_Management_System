<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            brightloop_finance Security Groups
            Member 4 — Finance Module

            Role hierarchy (aligned with Member 1 brightloop_core groups):

            brightloop_core.group_brightloop_admin
              └─ (implies) brightloop_core.group_brightloop_staff
                   └─ (implies) base.group_user

            Finance roles sit alongside core roles:
              group_brightloop_finance_manager implies group_brightloop_finance_user
                AND brightloop_core.group_brightloop_admin
                  (Finance Managers are Brightloop Admins)

              group_brightloop_finance_user implies brightloop_core.group_brightloop_staff
                (Finance Users are Brightloop internal staff)

            This means assigning 'Finance Manager' automatically grants admin-level
            core access, and 'Finance User' automatically grants staff-level core access.
        -->

        <!-- Finance User: internal staff who can record payments and view dashboard -->
        <!-- implied_ids: also grants brightloop_core.group_brightloop_staff -->
        <record id="group_brightloop_finance_user" model="res.groups">
            <field name="name">Finance User</field>
            <field name="category_id" ref="brightloop_core.module_category_brightloop"/>
            <field name="implied_ids" eval="[(4, ref('brightloop_core.group_brightloop_staff'))]"/>
            <field name="comment">Can record payments, view invoices and dashboard. Cannot configure payment methods. Implies Brightloop Staff role.</field>
        </record>

        <!-- Finance Manager: full CRUD, reports, export, payment method config -->
        <!-- implied_ids: also grants group_brightloop_finance_user AND brightloop_core.group_brightloop_admin -->
        <record id="group_brightloop_finance_manager" model="res.groups">
            <field name="name">Finance Manager</field>
            <field name="category_id" ref="brightloop_core.module_category_brightloop"/>
            <field name="implied_ids" eval="[
                (4, ref('group_brightloop_finance_user')),
                (4, ref('brightloop_core.group_brightloop_admin'))
            ]"/>
            <field name="comment">Can configure payment methods, access all customer data, and run all reports/exports. Implies Finance User and Brightloop Administrator roles.</field>
        </record>

    </data>
</odoo>

