<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_wizard_form" model="ir.ui.view">
        <field name="name">brightloop.payment.wizard.form</field>
        <field name="model">brightloop.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Payment">
                <sheet>
                    <h2>Record a Payment</h2>

                    <group string="Payment Details">
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="payment_method_id" options="{'no_create': True}"/>
                            <field name="amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="payment_date"/>
                            <field name="reference"/>
                        </group>
                    </group>

                    <field name="notes" placeholder="Optional notes..."/>

                    <group string="Allocate to Invoices">
                        <field name="allocation_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="invoice_id" optional="hide"/>
                                <field name="invoice_number" optional="show"/>
                                <field name="due_date" optional="show"/>
                                <field name="invoice_total" optional="show"/>
                                <field name="balance_due" optional="show"/>
                                <field name="allocated_amount" sum="Total"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </group>

                    <group>
                        <group>
                            <field name="total_allocated" string="Total Allocated"/>
                            <field name="remaining" string="Unallocated Remaining"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm Payment"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payment_wizard" model="ir.actions.act_window">
        <field name="name">Record Payment</field>
        <field name="res_model">brightloop.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_brightloop_record_payment"
              name="Record Payment"
              parent="menu_brightloop_finance_root"
              action="action_payment_wizard"
              sequence="5"/>

</odoo>

