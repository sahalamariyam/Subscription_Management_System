<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-level Brightloop Subscription Application Menu -->
    <menuitem id="menu_brightloop_subscription_root"
              name="Brightloop Subscriptions"
              web_icon="brightloop_subscription,static/description/icon.png"
              sequence="20"
              groups="brightloop_core.group_brightloop_staff,brightloop_core.group_brightloop_admin"/>

    <!-- Operational Submenus -->
    <menuitem id="menu_brightloop_subscriptions"
              name="Subscriptions"
              parent="menu_brightloop_subscription_root"
              sequence="10"/>

    <menuitem id="menu_brightloop_catalog"
              name="Catalog &amp; Plans"
              parent="menu_brightloop_subscription_root"
              sequence="20"/>

    <menuitem id="menu_brightloop_configuration"
              name="Configuration"
              parent="menu_brightloop_subscription_root"
              sequence="100"
              groups="brightloop_core.group_brightloop_admin"/>
</odoo>
