<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product List / Tree View -->
    <record id="view_brightloop_product_tree" model="ir.ui.view">
        <field name="name">brightloop.product.tree</field>
        <field name="model">brightloop.product</field>
        <field name="arch" type="xml">
            <list string="Products">
                <field name="name"/>
                <field name="product_type" widget="badge"
                       decoration-info="product_type == 'software'"
                       decoration-success="product_type == 'addon'"
                       decoration-warning="product_type == 'service'"/>
                <field name="sales_price"/>
                <field name="cost_price"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Product Form View -->
    <record id="view_brightloop_product_form" model="ir.ui.view">
        <field name="name">brightloop.product.form</field>
        <field name="model">brightloop.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Product Name"/>
                        <h1><field name="name" placeholder="e.g. Cloud Business Suite"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_type"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="sales_price"/>
                            <field name="cost_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Variants" name="variants">
                            <field name="variant_ids">
                                <list editable="bottom" string="Variants">
                                    <field name="name" placeholder="e.g. Odoo Brand"/>
                                    <field name="price_adjustment"/>
                                    <field name="effective_price" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Enter product notes, specifications, or terms..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Product Search View -->
    <record id="view_brightloop_product_search" model="ir.ui.view">
        <field name="name">brightloop.product.search</field>
        <field name="model">brightloop.product</field>
        <field name="arch" type="xml">
            <search string="Search Products">
                <field name="name"/>
                <filter string="Software" name="filter_software" domain="[('product_type', '=', 'software')]"/>
                <filter string="Add-ons" name="filter_addon" domain="[('product_type', '=', 'addon')]"/>
                <filter string="Services" name="filter_service" domain="[('product_type', '=', 'service')]"/>
                <separator/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Product Type" name="group_product_type" context="{'group_by': 'product_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Product Window Action -->
    <record id="action_brightloop_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">brightloop.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_brightloop_product_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription product or add-on!
            </p>
            <p>
                Manage business software, recurring add-ons, and services with configurable variant price adjustments.
            </p>
        </field>
    </record>

    <!-- Catalog Menu Item for Products -->
    <menuitem id="menu_brightloop_product_action"
              name="Products"
              parent="menu_brightloop_catalog"
              action="action_brightloop_product"
              sequence="10"/>
</odoo>
