<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quotation Template List View -->
    <record id="view_brightloop_quotation_template_tree" model="ir.ui.view">
        <field name="name">brightloop.quotation.template.tree</field>
        <field name="model">brightloop.quotation.template</field>
        <field name="arch" type="xml">
            <list string="Quotation Templates">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="validity_days"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Quotation Template Form View -->
    <record id="view_brightloop_quotation_template_form" model="ir.ui.view">
        <field name="name">brightloop.quotation.template.form</field>
        <field name="model">brightloop.quotation.template</field>
        <field name="arch" type="xml">
            <form string="Quotation Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Template Name"/>
                        <h1><field name="name" placeholder="e.g. Standard SaaS Offer"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="validity_days"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Offer Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" string="Template Lines">
                                    <field name="product_id"/>
                                    <field name="variant_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="tax_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quotation Template Action -->
    <record id="action_brightloop_quotation_template" model="ir.actions.act_window">
        <field name="name">Quotation Templates</field>
        <field name="res_model">brightloop.quotation.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create reusable quotation templates!
            </p>
            <p>
                Sales representatives can quickly prepare customer offers from templates pre-loaded with subscription plans and product lines.
            </p>
        </field>
    </record>

    <!-- Menu Item for Quotation Templates -->
    <menuitem id="menu_brightloop_quotation_template_action"
              name="Quotation Templates"
              parent="menu_brightloop_configuration"
              action="action_brightloop_quotation_template"
              sequence="30"/>
</odoo>
