<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Portal Home Dashboard Extensions -->
    <template id="portal_my_home_brightloop" name="Brightloop Portal Navigation" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <!-- 1. My Subscriptions (Member 2 Placeholder) -->
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Subscriptions</t>
                <t t-set="text">Active subscription plans, recurring services, and renewals</t>
                <t t-set="url" t-value="'/my/subscriptions'"/>
            </t>
            <!-- 2. My Quotations (Member 2 Placeholder) -->
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Quotations</t>
                <t t-set="text">Subscription quotes, custom pricing proposals, and approvals</t>
                <t t-set="url" t-value="'/my/quotations'"/>
            </t>
            <!-- 3. My Invoices (Member 3 Placeholder) -->
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Invoices</t>
                <t t-set="text">Billing statements, tax invoices, and payment status</t>
                <t t-set="url" t-value="'/my/invoices'"/>
            </t>
            <!-- 4. My Payments (Member 4 Placeholder) -->
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Payments</t>
                <t t-set="text">Payment receipts, transaction history, and payment methods</t>
                <t t-set="url" t-value="'/my/payments'"/>
            </t>
        </div>
    </template>

    <!-- Reusable Portal Integration Placeholder View -->
    <template id="portal_integration_placeholder" name="Brightloop Module Integration Placeholder">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0">
                            <div class="card-body p-4 text-center">
                                <div class="badge bg-primary-subtle text-primary mb-3 px-3 py-2 fs-6">
                                    Integration Point: <t t-esc="workstream_addon"/> (<t t-esc="workstream_member"/>)
                                </div>
                                <h3 class="card-title fw-bold mb-3"><t t-esc="title"/></h3>
                                <p class="card-text text-muted mb-4 fs-6">
                                    <t t-esc="description"/>
                                </p>
                                <div class="alert alert-info border-0 rounded-3 text-start small">
                                    <h6 class="fw-bold mb-1"><i class="fa fa-info-circle me-1"/> Workstream Contract Notice</h6>
                                    This customer portal section is reserved for the <code><t t-esc="workstream_addon"/></code> addon.
                                    The authentication, security isolation, and navigation contracts are managed by Member 1 (Platform Foundation).
                                </div>
                                <a href="/my/home" class="btn btn-outline-secondary mt-3">
                                    <i class="fa fa-arrow-left me-1"/> Return to Customer Portal
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
