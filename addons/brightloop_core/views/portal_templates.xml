<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Portal Home Dashboard Extensions ─────────────────────────────── -->
    <template id="portal_my_home_brightloop" name="Brightloop Portal Navigation"
              inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <!-- 1. My Subscriptions (Member 2) -->
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Subscriptions</t>
                <t t-set="text">Active subscription plans, recurring services, and renewals</t>
                <t t-set="url" t-value="'/my/subscriptions'"/>
                <t t-set="count" t-value="subscription_count"/>
            </t>
            <!-- 2. My Quotations (Member 2) -->
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Quotations</t>
                <t t-set="text">Subscription quotes, custom pricing proposals, and approvals</t>
                <t t-set="url" t-value="'/my/quotations'"/>
            </t>
            <!-- 3. My Invoices (Member 3) -->
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Invoices</t>
                <t t-set="text">Billing statements, tax invoices, and payment status</t>
                <t t-set="url" t-value="'/my/invoices'"/>
                <t t-set="count" t-value="invoice_count"/>
            </t>
            <!-- 4. My Payments (Member 4) -->
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Payments</t>
                <t t-set="text">Payment receipts, transaction history, and payment methods</t>
                <t t-set="url" t-value="'/my/payments'"/>
                <t t-set="count" t-value="payment_count"/>
            </t>
        </div>
    </template>

    <!-- ─── Shared macro: status badge ───────────────────────────────────── -->
    <template id="portal_subscription_status_badge">
        <!-- expects t-set status_val and is_paused_val in calling context -->
        <t t-if="is_paused_val">
            <span class="badge bg-info text-dark">Paused</span>
        </t>
        <t t-elif="status_val == 'active'">
            <span class="badge bg-success">Active</span>
        </t>
        <t t-elif="status_val == 'confirmed'">
            <span class="badge bg-primary">Confirmed</span>
        </t>
        <t t-elif="status_val == 'draft'">
            <span class="badge bg-secondary">Draft</span>
        </t>
        <t t-elif="status_val == 'quotation'">
            <span class="badge bg-warning text-dark">Quotation</span>
        </t>
        <t t-elif="status_val == 'closed'">
            <span class="badge bg-light text-muted border">Closed</span>
        </t>
        <t t-else="">
            <span class="badge bg-light text-muted border">
                <t t-esc="status_val"/>
            </span>
        </t>
    </template>

    <!-- ─── /my/subscriptions ─────────────────────────────────────────────── -->
    <template id="portal_subscriptions" name="My Subscriptions">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Subscriptions</t>
            </t>

            <!-- Sort / Filter bar -->
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div class="d-flex gap-2 flex-wrap">
                    <!-- Filter tabs -->
                    <t t-foreach="filter_options.items()" t-as="fo" t-key="fo[0]">
                        <a t-att-href="'/my/subscriptions?filterby=' + fo[0] + '&amp;sortby=' + sortby"
                           t-att-class="'btn btn-sm ' + ('btn-primary' if filterby == fo[0] else 'btn-outline-secondary')">
                            <t t-esc="fo[1]['label']"/>
                        </a>
                    </t>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <span class="text-muted small">Sort:</span>
                    <t t-foreach="sort_options.items()" t-as="so" t-key="so[0]">
                        <a t-att-href="'/my/subscriptions?filterby=' + filterby + '&amp;sortby=' + so[0]"
                           t-att-class="'btn btn-sm ' + ('btn-secondary' if sortby == so[0] else 'btn-outline-secondary')">
                            <t t-esc="so[1]['label']"/>
                        </a>
                    </t>
                </div>
            </div>

            <t t-if="module_unavailable">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle me-2"/>
                    Subscription module is not yet available.
                </div>
            </t>
            <t t-elif="not subscriptions">
                <div class="o_portal_docs text-center py-5">
                    <i class="fa fa-inbox fa-3x text-muted mb-3 d-block"/>
                    <p class="text-muted">No subscriptions found.</p>
                    <a href="/my/quotations" class="btn btn-outline-primary btn-sm">
                        View Quotations
                    </a>
                </div>
            </t>
            <t t-else="">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Reference</th>
                                <th>Plan</th>
                                <th>Status</th>
                                <th>Start Date</th>
                                <th class="text-end">Next Billing</th>
                                <th/>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="subscriptions" t-as="sub">
                                <tr>
                                    <td class="fw-semibold">
                                        <t t-esc="sub.name or '—'"/>
                                    </td>
                                    <td>
                                        <t t-esc="sub.plan_id and sub.plan_id.name or '—'"/>
                                    </td>
                                    <td>
                                        <t t-set="status_val" t-value="sub.status"/>
                                        <t t-set="is_paused_val" t-value="sub.is_paused"/>
                                        <t t-call="brightloop_core.portal_subscription_status_badge"/>
                                    </td>
                                    <td>
                                        <t t-esc="sub.start_date or '—'"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="sub.next_billing_date or '—'"/>
                                    </td>
                                    <td class="text-end">
                                        <a t-att-href="'/my/subscriptions/' + str(sub.id)"
                                           class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <t t-call="portal.pager" t-if="pager"/>
            </t>
        </t>
    </template>

    <!-- ─── /my/subscriptions/<id> detail ────────────────────────────────── -->
    <template id="portal_subscription_detail" name="Subscription Detail">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/my/home">Home</a></li>
                        <li class="breadcrumb-item"><a href="/my/subscriptions">My Subscriptions</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <t t-esc="subscription.name"/>
                        </li>
                    </ol>
                </nav>

                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold">
                            <i class="fa fa-refresh me-2 text-primary"/>
                            <t t-esc="subscription.name"/>
                        </h5>
                        <t t-set="status_val" t-value="subscription.status"/>
                        <t t-set="is_paused_val" t-value="subscription.is_paused"/>
                        <t t-call="brightloop_core.portal_subscription_status_badge"/>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <th class="text-muted w-40">Plan</th>
                                        <td><t t-esc="subscription.plan_id and subscription.plan_id.name or '—'"/></td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Start Date</th>
                                        <td><t t-esc="subscription.start_date or '—'"/></td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Expiry Date</th>
                                        <td><t t-esc="subscription.expiry_date or '—'"/></td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Next Billing</th>
                                        <td><t t-esc="subscription.next_billing_date or '—'"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <th class="text-muted w-40">Product</th>
                                        <td><t t-esc="subscription.product_id and subscription.product_id.name or '—'"/></td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Quantity</th>
                                        <td><t t-esc="subscription.quantity or 1"/></td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Unit Price</th>
                                        <td>
                                            <t t-esc="subscription.plan_id and subscription.plan_id.price or 0"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <t t-if="subscription.notes">
                            <hr/>
                            <p class="text-muted small"><t t-esc="subscription.notes"/></p>
                        </t>
                    </div>
                    <div class="card-footer bg-white">
                        <a href="/my/subscriptions" class="btn btn-outline-secondary btn-sm">
                            <i class="fa fa-arrow-left me-1"/>Back to Subscriptions
                        </a>
                        <a href="/my/invoices" class="btn btn-outline-primary btn-sm ms-2">
                            <i class="fa fa-file-text-o me-1"/>View Invoices
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ─── /my/quotations ───────────────────────────────────────────────── -->
    <template id="portal_quotations" name="My Quotations">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Quotations</t>
            </t>

            <t t-if="module_unavailable">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle me-2"/>Subscription module not yet available.
                </div>
            </t>
            <t t-elif="not subscriptions">
                <div class="text-center py-5">
                    <i class="fa fa-inbox fa-3x text-muted mb-3 d-block"/>
                    <p class="text-muted">No pending quotations.</p>
                </div>
            </t>
            <t t-else="">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Reference</th>
                                <th>Plan</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th/>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="subscriptions" t-as="sub">
                                <tr>
                                    <td class="fw-semibold"><t t-esc="sub.name or '—'"/></td>
                                    <td><t t-esc="sub.plan_id and sub.plan_id.name or '—'"/></td>
                                    <td>
                                        <t t-set="status_val" t-value="sub.status"/>
                                        <t t-set="is_paused_val" t-value="False"/>
                                        <t t-call="brightloop_core.portal_subscription_status_badge"/>
                                    </td>
                                    <td><t t-esc="sub.create_date"/></td>
                                    <td class="text-end">
                                        <a t-att-href="'/my/subscriptions/' + str(sub.id)"
                                           class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <t t-call="portal.pager" t-if="pager"/>
            </t>
        </t>
    </template>

    <!-- ─── /my/invoices ─────────────────────────────────────────────────── -->
    <template id="portal_invoices" name="My Invoices">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Invoices</t>
            </t>

            <!-- Filter tabs -->
            <div class="d-flex gap-2 mb-3 flex-wrap">
                <t t-foreach="filter_options.items()" t-as="fo" t-key="fo[0]">
                    <a t-att-href="'/my/invoices?filterby=' + fo[0]"
                       t-att-class="'btn btn-sm ' + ('btn-primary' if filterby == fo[0] else 'btn-outline-secondary')">
                        <t t-esc="fo[1]['label']"/>
                    </a>
                </t>
            </div>

            <t t-if="not invoices">
                <div class="text-center py-5">
                    <i class="fa fa-file-text-o fa-3x text-muted mb-3 d-block"/>
                    <p class="text-muted">No invoices found.</p>
                </div>
            </t>
            <t t-else="">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Invoice #</th>
                                <th>Date</th>
                                <th>Due Date</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Outstanding</th>
                                <th>Status</th>
                                <th/>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="invoices" t-as="inv">
                                <tr>
                                    <td class="fw-semibold text-primary">
                                        <t t-esc="inv.name"/>
                                    </td>
                                    <td><t t-esc="inv.invoice_date"/></td>
                                    <td>
                                        <span t-att-class="'text-danger fw-semibold' if inv.invoice_date_due and inv.payment_state not in ['paid','reversed'] and inv.amount_residual > 0 else ''">
                                            <t t-esc="inv.invoice_date_due or '—'"/>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="'$%.2f' % inv.amount_total"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-att-class="'text-danger fw-semibold' if inv.amount_residual > 0 else 'text-muted'">
                                            <t t-esc="'$%.2f' % inv.amount_residual"/>
                                        </span>
                                    </td>
                                    <td>
                                        <t t-if="inv.payment_state == 'paid'">
                                            <span class="badge bg-success">Paid</span>
                                        </t>
                                        <t t-elif="inv.payment_state == 'partial'">
                                            <span class="badge bg-warning text-dark">Partial</span>
                                        </t>
                                        <t t-elif="inv.payment_state == 'in_payment'">
                                            <span class="badge bg-info text-dark">In Payment</span>
                                        </t>
                                        <t t-elif="inv.payment_state == 'reversed'">
                                            <span class="badge bg-secondary">Reversed</span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge bg-danger">Unpaid</span>
                                        </t>
                                    </td>
                                    <td class="text-end">
                                        <a t-att-href="'/my/invoices/' + str(inv.id)"
                                           class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <t t-call="portal.pager" t-if="pager"/>
            </t>
        </t>
    </template>

    <!-- ─── /my/invoices/<id> detail ─────────────────────────────────────── -->
    <template id="portal_invoice_detail" name="Invoice Detail">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/my/home">Home</a></li>
                        <li class="breadcrumb-item"><a href="/my/invoices">My Invoices</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <t t-esc="invoice.name"/>
                        </li>
                    </ol>
                </nav>

                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 d-flex justify-content-between">
                        <h5 class="mb-0 fw-bold">
                            <i class="fa fa-file-text-o me-2 text-primary"/>
                            <t t-esc="invoice.name"/>
                        </h5>
                        <t t-if="invoice.payment_state == 'paid'">
                            <span class="badge bg-success fs-6">Paid</span>
                        </t>
                        <t t-elif="invoice.payment_state == 'partial'">
                            <span class="badge bg-warning text-dark fs-6">Partial</span>
                        </t>
                        <t t-else="">
                            <span class="badge bg-danger fs-6">Unpaid</span>
                        </t>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <th class="text-muted">Invoice Date</th>
                                        <td><t t-esc="invoice.invoice_date"/></td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted">Due Date</th>
                                        <td><t t-esc="invoice.invoice_date_due or '—'"/></td>
                                    </tr>
                                    <tr t-if="'subscription_id' in invoice._fields and invoice.subscription_id">
                                        <th class="text-muted">Subscription</th>
                                        <td>
                                            <a t-att-href="'/my/subscriptions/' + str(invoice.subscription_id.id)">
                                                <t t-esc="invoice.subscription_id.name"/>
                                            </a>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <div class="display-6 fw-bold">
                                    <t t-esc="'$%.2f' % invoice.amount_total"/>
                                </div>
                                <div class="text-muted">Total</div>
                                <div class="mt-2">
                                    <span class="text-danger fw-semibold">
                                        Outstanding: <t t-esc="'$%.2f' % invoice.amount_residual"/>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Invoice Lines -->
                        <div class="table-responsive mt-3">
                            <table class="table table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Description</th>
                                        <th class="text-end">Qty</th>
                                        <th class="text-end">Unit Price</th>
                                        <th class="text-end">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="invoice.invoice_line_ids" t-as="line">
                                        <t t-if="line.display_type == 'product'">
                                            <tr>
                                                <td><t t-esc="line.name"/></td>
                                                <td class="text-end"><t t-esc="line.quantity"/></td>
                                                <td class="text-end"><t t-esc="'$%.2f' % line.price_unit"/></td>
                                                <td class="text-end fw-semibold"><t t-esc="'$%.2f' % line.price_subtotal"/></td>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="3" class="text-end fw-bold">Total</td>
                                        <td class="text-end fw-bold">
                                            <t t-esc="'$%.2f' % invoice.amount_total"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-white">
                        <a href="/my/invoices" class="btn btn-outline-secondary btn-sm">
                            <i class="fa fa-arrow-left me-1"/>Back to Invoices
                        </a>
                        <a href="/my/payments" class="btn btn-outline-primary btn-sm ms-2">
                            <i class="fa fa-credit-card me-1"/>View Payments
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ─── /my/payments ─────────────────────────────────────────────────── -->
    <template id="portal_payments" name="My Payments">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Payments</t>
            </t>

            <t t-if="module_unavailable">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle me-2"/>Payment module not yet available.
                </div>
            </t>
            <t t-elif="not payments">
                <div class="text-center py-5">
                    <i class="fa fa-credit-card fa-3x text-muted mb-3 d-block"/>
                    <p class="text-muted">No payment records found.</p>
                    <a href="/my/invoices" class="btn btn-outline-primary btn-sm">
                        View Invoices
                    </a>
                </div>
            </t>
            <t t-else="">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Reference</th>
                                <th>Method</th>
                                <th>Date</th>
                                <th class="text-end">Amount</th>
                                <th class="text-end">Allocated</th>
                                <th class="text-end">Unallocated</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="payments" t-as="pmt">
                                <tr>
                                    <td class="fw-semibold text-primary">
                                        <t t-esc="pmt.name"/>
                                        <t t-if="pmt.reference">
                                            <br/>
                                            <small class="text-muted">Ref: <t t-esc="pmt.reference"/></small>
                                        </t>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary border">
                                            <t t-esc="pmt.payment_method_id and pmt.payment_method_id.name or '—'"/>
                                        </span>
                                    </td>
                                    <td><t t-esc="pmt.payment_date"/></td>
                                    <td class="text-end fw-bold">
                                        <t t-esc="'$%.2f' % pmt.amount"/>
                                    </td>
                                    <td class="text-end text-success">
                                        <t t-esc="'$%.2f' % pmt.total_allocated"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-att-class="'text-warning fw-semibold' if pmt.unallocated_amount > 0 else 'text-muted'">
                                            <t t-esc="'$%.2f' % pmt.unallocated_amount"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <t t-call="portal.pager" t-if="pager"/>
            </t>
        </t>
    </template>

</odoo>
