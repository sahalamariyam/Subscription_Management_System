<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Customer Data Isolation: User Self-Access Only -->
        <record id="rule_brightloop_customer_user_isolation" model="ir.rule">
            <field name="name">Brightloop Customer: User Self-Access Only</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="groups" eval="[(4, ref('group_brightloop_customer'))]"/>
            <field name="domain_force">[('id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Customer Data Isolation: Partner Self-Access Only -->
        <record id="rule_brightloop_customer_partner_isolation" model="ir.rule">
            <field name="name">Brightloop Customer: Partner Self-Access Only</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('group_brightloop_customer'))]"/>
            <field name="domain_force">[('id', 'child_of', user.commercial_partner_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
