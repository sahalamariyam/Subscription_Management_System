<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Security Category -->
        <record id="module_category_brightloop" model="ir.module.category">
            <field name="name">Brightloop</field>
            <field name="description">Access management and security roles for Brightloop Subscription Management System</field>
            <field name="sequence">10</field>
        </record>

        <!-- Role 1: Customer (Portal User) -->
        <record id="group_brightloop_customer" model="res.groups">
            <field name="name">Customer</field>
            <field name="category_id" ref="module_category_brightloop"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
            <field name="comment">External customer portal user. Access is restricted exclusively to their own records, subscriptions, and invoices.</field>
        </record>

        <!-- Role 2: Staff (Internal User) -->
        <record id="group_brightloop_staff" model="res.groups">
            <field name="name">Staff</field>
            <field name="category_id" ref="module_category_brightloop"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Internal operational staff. Operational access to subscriptions, invoices, and customer management. Cannot create staff accounts or modify security settings.</field>
        </record>

        <!-- Role 3: Administrator (Platform Admin) -->
        <record id="group_brightloop_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_brightloop"/>
            <field name="implied_ids" eval="[(4, ref('group_brightloop_staff')), (4, ref('base.group_erp_manager'))]"/>
            <field name="comment">Platform administrator with full application access: staff account creation, customer management, shared configuration, and security management.</field>
        </record>
    </data>
</odoo>
